# Python-related files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environment
venv/
.venv/
env/

# Environment variables (never commit secrets)
.env
.env.*
!.env.example

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Databases (if used for local dev/testing)
*.db
*.sqlite3

# Large source PDFs (source data, not app code)
*.pdf

# OS / editor cruft
.DS_Store
.vscode/
.idea/

# Logs
*.log
*.tmp

# Test / coverage artifacts
.pytest_cache/
.coverage
htmlcov/